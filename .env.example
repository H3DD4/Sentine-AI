# ─────────────────────────────────────────────────────────────
# Sentinel.AI — Environment Configuration Template
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────
# SQLite for local dev; PostgreSQL for production (see docker-compose.yml)
DATABASE_URL=sqlite+aiosqlite:///./test.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/redteam_rag

# ─── Vector DB (Qdrant) ──────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=kb_entries
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_CHUNK_TOKENS=800
EMBEDDING_CHUNK_OVERLAP_TOKENS=100
RERANK_ENABLED=false
RERANK_CANDIDATES=15
RERANK_TIMEOUT_SECONDS=30
RETRIEVAL_CACHE_ENABLED=true
RETRIEVAL_CACHE_TTL_SECONDS=300
RETRIEVAL_CACHE_MAX_ENTRIES=512
RETRIEVAL_CACHE_BACKEND=auto
RETRIEVAL_CACHE_REDIS_URL=redis://localhost:6379/0
RETRIEVAL_CACHE_LOCK_SECONDS=15
RETRIEVAL_CACHE_LOCK_WAIT_SECONDS=2
RETRIEVAL_CACHE_TTL_JITTER_SECONDS=30
RETRIEVAL_WORKSPACE_MAX_SEARCHES=12
RETRIEVAL_WORKSPACE_MAX_HITS=20

# ─── LLM Provider Selection ──────────────────────────────────
# Using OpenRouter with free models only
LLM_PROVIDER=openrouter
CHAT_MAX_TOKENS=6000
CHAT_MAX_CONTINUATIONS=2

# ─── OpenRouter ──────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=z-ai/glm-5.2:free
OPENROUTER_VALIDATION_MODEL=z-ai/glm-5.2:free
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_CHAT_FALLBACK_MODELS=["google/gemini-2.5-flash-lite"]
OPENROUTER_VALIDATION_FALLBACK_MODELS=[]
OPENROUTER_VISION_FALLBACK_MODELS=["nvidia/nemotron-nano-12b-v2-vl:free"]
LLM_MODEL_COOLDOWN_SECONDS=120
LLM_CAPACITY_RETRIES=1
LLM_RATE_LIMIT_REQUESTS=1
LLM_RATE_LIMIT_WINDOW_SECONDS=20
LLM_RATE_LIMIT_MAX_BACKOFF_SECONDS=30
VISION_STAGE_TIMEOUT_SECONDS=30
VALIDATION_STAGE_TIMEOUT_SECONDS=45

# ─── NVD CVE Sync ────────────────────────────────────────────
NVD_API_KEY=
NVD_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0

# ─── MITRE ATT&CK Sync ───────────────────────────────────────
MITRE_STIX_URL=https://github.com/mitre-attack/attack-stix-data/releases/latest/download/enterprise-attack.json

# ─── Ghostwriter (optional external reporting tool) ──────────
# Use the server origin or the full /v1/graphql URL. For a local installation
# with Ghostwriter's self-signed certificate, explicitly disable verification.
GHOSTWRITER_URL=
GHOSTWRITER_API_KEY=
GHOSTWRITER_VERIFY_TLS=true

# ─── Auth (JWT) ──────────────────────────────────────────────
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── App ─────────────────────────────────────────────────────
API_KEY=
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:8003", "http://localhost:5173"]
CORS_ALLOW_LOCALHOST=true
UPLOAD_DIR=/tmp/redteam_evidence
REPORT_TEMPLATE_DIR=/tmp/redteam_report_templates
EVIDENCE_MAX_FILES=20
EVIDENCE_MAX_FILE_BYTES=52428800
EVIDENCE_MAX_TOTAL_BYTES=104857600
EVIDENCE_UPLOAD_CHUNK_BYTES=1048576
